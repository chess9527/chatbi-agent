# LLM 配置（DeepSeek 示例：https://platform.deepseek.com）
LLM_API_KEY=sk-xxx
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 主模型连续失败后的降级模型（OpenAI 兼容），留空则不启用降级
FALLBACK_MODEL=

# Streamlit 连接的后端地址
API_BASE=http://localhost:8000

# 可选覆盖
# DB_PATH=data/ecommerce.db
# SESSION_TOKEN_BUDGET=200000
# MAX_ROWS=200
